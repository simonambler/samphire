    <y-panel id="ia9b">
        <y-panel-item id="j639">
            <h3>Background</h3>
            <y-text id="tv1y">
                <p>Cecil has served the burrow parishes of Mossburrow for two decades, ministering to the sick, settling boundary disputes, and keeping the old root-rites alive. He is slow to anger, quick to listen, and surprisingly handy with his oak staff when weasels come calling.</p>
            </y-text>
        </y-panel-item>
    </y-panel>
    <y-panel id="l32n">
        <y-panel-item id="8kas">
            <h3>Skills</h3>
            <y-list tag="Skills" id="5zh2">
                <y-list-item tag="Skill" id="i60r">
                    <b><y-cell tag="Name" id="xu8s">Speak Kindly</y-cell></b>
                    (<y-cell tag="Stat" id="zgxh">Heart</y-cell>)
                    <y-cell tag="Level" id="754q">13</y-cell>.
                    <y-cell tag="Summary" id="bmbw">Calm troubled souls, mediate disputes, and earn trust across species.</y-cell>
                </y-list-item>
                <y-list-item tag="Skill" id="exig">
                    <b><y-cell tag="Name" id="n1er">Herblore</y-cell></b>
                    (<y-cell tag="Stat" id="qa5v">Wits</y-cell>)
                    <y-cell tag="Level" id="kfzd">11</y-cell>.
                    <y-cell tag="Summary" id="hfnr">Prepare healing poultices, identify ailments, and tend the wounded.</y-cell>
                </y-list-item>
                <y-list-item tag="Skill" id="93o0">
                    <b><y-cell tag="Name" id="bitz">Burrowcraft</y-cell></b>
                    (<y-cell tag="Stat" id="s302">Brawn</y-cell>)
                    <y-cell tag="Level" id="3pbw">9</y-cell>.
                    <y-cell tag="Summary" id="y7x7">Shape and shore up tunnels, dig new passages, and find safe routes underground.</y-cell>
                </y-list-item>
                <y-catalogue id="6ea1">
                    <y-catalogue-item filter="Skill" label="Skill" id="pt72" url="/samphire/data/demo/type/catalogue/sheet/skills"/>
